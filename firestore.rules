rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRoomMember(roomData) {
      return isAuthenticated() && (request.auth.uid in roomData.members);
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                    && request.resource.data.creator == request.auth.uid;
      allow update: if isAuthenticated() 
                    && (isRoomMember(resource.data) || resource.data.members.size() < 2);
      allow delete: if isAuthenticated() && isRoomMember(resource.data);

      // Messages subcollection inside a room
      match /messages/{messageId} {
        allow read, create, delete: if isAuthenticated() 
                                    && isRoomMember(get(/databases/$(database)/documents/rooms/$(roomId)).data);
      }
    }
  }
}
